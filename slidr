#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOCAL_CONFIG="${SCRIPT_DIR}/config/config.yaml"

usage() {
  cat <<EOF
Usage: $(basename "$0") --bcl BCL_ID [OPTIONS]
       $(basename "$0") --version

Required:
  --bcl BCL_ID          BCL run ID passed to workflow/main.py

Informational (these exit immediately and need no other flags):
  -v, --version         Print the pipeline version and exit
  -h, --help            Print this message and exit
  -u, --update          Pull the newest slidr from GitHub and exit. Fast-forward
                         only; local edits (config/config.yaml, typically) are
                         kept unless the update touches the same file, in which
                         case it stops and tells you to stash. A run also checks
                         once a day and says so when a newer version is out;
                         SLIDR_NO_UPDATE_CHECK=1 disables that check,
                         SLIDR_UPDATE_INTERVAL=<seconds> re-times it

Where inputs come from:
  Staging location is configuration, not a flag. \`paths.input_path\` in
  config/config.yaml is dual-purpose: a local directory of run folders normally,
  and the GCS prefix they are staged out of when staging. The VM or compute node
  is handed that location and downloads what it needs itself. --gcp always stages
  (a fresh VM has nothing else); --slurm stages only when asked with --stage-gcs.

  Both read the <BCL_ID> data folder from that prefix, and nothing else: no
  config.yaml or auth_key.json has to be put in a bucket by hand. A --slurm run
  uses config/config.yaml from this checkout directly; a --gcp run uploads that
  same file to <output_bucket>/<BCL_ID>/config.yaml and the VM boots from it, so
  the config a run uses is always the one you just edited. A gs:// value for
  \`paths.auth_key_path\` is read straight out of the bucket when the metadata
  sheet is opened, never written to the machine's disk.

  Staged data lands in \`settings.gcs_download_dest\`, or -- left unset -- under
  the run's own directory at <output_path>/<BCL_ID>/data.

GCP VM options:
  --project  PROJECT    GCP project (required for --gcp; no default)
  --zone     ZONE       GCP zone           (default: us-central1-a)
  --machine  TYPE       Machine type       (default: n1-standard-16)
  --disk     SIZE       Boot disk size     (default: 200GB)
  --gpu [TYPE]          Attach a GPU. TYPE is optional and defaults to
                         nvidia-tesla-t4; pass a GCE accelerator name to pick
                         another (e.g. --gpu nvidia-l4). List what a zone offers
                         with \`gcloud compute accelerator-types list\`. Under
                         --slurm an explicit TYPE becomes a gres type
                         (--gres=gpu:TYPE:1), which must match your cluster's
                         gres.conf naming rather than GCE's.

Slurm options (only apply with --slurm; CPUs and memory are read from
settings.threads / settings.memory in the config the job will run with):
  --partition NAME      Slurm partition to submit to (default: cluster default)
  --time      LIMIT     Job time limit, e.g. 24:00:00 or 1-00:00:00 (default: 24:00:00)

Slurm staging options (only apply with --slurm --stage-gcs):
  --workdir  PATH       Directory on cluster storage to stage inputs into and
                         write outputs to. Usually unnecessary: it defaults to
                         the parent of \`paths.output_path\` in the config, then
                         to \$SCRATCH/slidr, then to <repo>/slidr-work/<BCL_ID>.
                         Pass it when none of those is the right filesystem -- a
                         BCL run is routinely hundreds of GB.

Authenticating to GCS, and overriding \`software_path\` for this cluster, are done
outside slidr: run \`gcloud auth login\` (or \`gcloud auth activate-service-account\`)
once on the submit node, and export SLIDR_SOFTWARE_PATH before submitting. See
'All options' in the README.

Pipeline flags (passed through to workflow/main.py; short forms match its own):
  --fastqs, -fq [PATH]  Treat the input as already-demultiplexed FASTQs, skipping
                         cellranger mkfastq. PATH is optional: with no value the
                         FASTQs are read from \`paths.input_path\`, which is the
                         usual case. Mutually exclusive with --mkfastq. With --gcp
                         a PATH must be one on the VM (e.g. /pipeline/data/BCL_ID,
                         where the input bucket is staged).
  --metadata, -md PATH  Metadata .tsv/.csv path (or Google Sheet URL) for this
                         run, overriding \`settings.metadata_source\`.
  --stage-gcs, -sg      Fetch this run's inputs from GCS rather than the local
                         filesystem: reference_path/puck_path/raw_barcodes_path
                         for the pipeline, plus the run folders under
                         \`paths.input_path\`, and -- under --slurm -- the auth
                         key too. Implied by --gcp.
  --run-all, -ra        Run all pipeline components (default if no step flag given)
  --mkfastq, -mf        Run cellranger mkfastq only
  --count, -ct          Run cellranger count only
  --cellbender, -cb     Run cellbender only
  --no-cellbender, -nb  Skip cellbender when running the full pipeline
  --spatial-count, -sc  Run spatial barcode counting only
  --spatial-analysis, -sa
                        Run spatial analysis only
  --force, -f           Overwrite existing outputs

Where the run executes:
  --gcp, -gc            Create a GCE VM, run there, and stream its logs back
  --slurm, -sl          Submit as a Slurm batch job (consumed here, not passed on
                         to workflow/main.py, which has no --slurm flag)
EOF
  exit 1
}

# read a top-level scalar value for a key from config/config.yaml. Simple line-based parse
# (first matching `key:` line, inline comment stripped, value trimmed) -- NOT a full YAML parser;
# sufficient for slidr's flat scalar fields (input_path, output_path, threads, memory). Each of those
# names appears exactly once in the file, so which section it sits under does not have to be tracked.
# Prints nothing if the config file or key is absent.
read_config_scalar() {
    local key="$1" file="${2:-$LOCAL_CONFIG}" line
    [[ -f "$file" ]] || return 0
    line="$(grep -E "^[[:space:]]*${key}:" "$file" 2>/dev/null | head -1 || true)"
    line="${line%%#*}"                                # strip any inline comment
    cut -d: -f2- <<< "$line" | xargs 2>/dev/null || true   # value after first colon, trimmed
}

# Map a short pipeline flag to its long form.
#
# ./slidr accepts the same short options as workflow/main.py, but always *forwards* the long form.
# The pass-through flags are re-serialized into GCE instance metadata and echoed into the run
# summary, so pinning them to one canonical spelling keeps both readable no matter which spelling the
# caller used. Only the flags ./slidr passes through need to appear here -- the ones it consumes
# itself (--bcl and the GCP/Slurm options) are matched directly in the case statement.
canonical_flag() {
    case "$1" in
        -mf) echo "--mkfastq" ;;
        -ct) echo "--count" ;;
        -cb) echo "--cellbender" ;;
        -nb) echo "--no-cellbender" ;;
        -sc) echo "--spatial-count" ;;
        -sa) echo "--spatial-analysis" ;;
        -ra) echo "--run-all" ;;
        -f)  echo "--force" ;;
        -fq) echo "--fastqs" ;;
        -sg) echo "--stage-gcs" ;;
        -md) echo "--metadata" ;;
        -gc) echo "--gcp" ;;
        *)   echo "$1" ;;
    esac
}

# Strip every trailing slash from a GCS prefix.
#
# Everything downstream builds object URIs by appending directly to this prefix
# ("${INPUT}/${BCL_ID}", "${OUTPUT_BUCKET}/${BCL_ID}/config.yaml"), and GCS object names are literal
# strings: `in//run1` is a *different* object than `in/run1`, so a trailing slash would make
# every staging copy fail to find its input. This mirrors the normalization gcs_uri() applies to the
# `paths.*` fields on the Python side. A loop rather than "${value%/}" because that removes only one
# slash, leaving `inputs//` -- the very form that breaks -- still broken.
strip_trailing_slashes() {
    local value="$1"
    while [[ "$value" == */ ]]; do value="${value%/}"; done
    printf '%s' "$value"
}

# print the pipeline version and exit. Read straight out of pyproject.toml -- the same source
# config.py's get_version() falls back to -- rather than shelling out to `uv run python
# workflow/main.py --version`, so `--version` stays instant and keeps working on a machine where the
# Python environment has not been set up (or is broken), which is exactly when you want to check it.
# Only the `version` key inside the [project] table is considered: a bare grep would also match a
# version key belonging to some later [tool.*] table.
# Read the [project] version out of a pyproject.toml arriving on stdin. Separated from print_version
# so the same parse serves the local file and the copy on the remote branch (`git show @{u}:...`),
# which the update check compares against -- two readings of the same field must not disagree.
extract_version() {
    awk -F= '
        /^\[/            { in_project = ($0 == "[project]"); next }
        in_project && $1 ~ /^[ \t]*version[ \t]*$/ {
            gsub(/[ \t"'"'"']/, "", $2); print $2; exit
        }'
}

print_version() {
    local file="${SCRIPT_DIR}/pyproject.toml" version
    if [[ ! -f "$file" ]]; then
        echo "[ERROR]: cannot determine the slidr version: ${file} not found" >&2
        echo "Troubleshooting:" >&2
        echo " • Run \`./slidr --update\` to restore the missing pyproject.toml file" >&2
        echo " • Check you are running ./slidr from inside the repository checkout" >&2
        exit 1
    fi
    version="$(extract_version < "$file")"
    if [[ -z "$version" ]]; then
        echo "[ERROR]: cannot determine the slidr version: no \`version\` key in the [project] table of ${file}" >&2
        echo "Troubleshooting:" >&2
        echo " • Run \`git checkout pyproject.toml\` to restore the file to its committed state" >&2
        exit 1
    fi
    # same wording as `workflow/main.py --version`, so both entry points report identically
    echo "slidr version ${version}"
    exit 0
}

# --------------------------------------------------------------------------------------- #
#                                    staying up to date                                     #
# --------------------------------------------------------------------------------------- #
#
# How long between update checks, and where the last one is recorded. A check costs a network round
# trip, so doing it on every invocation would tax every run of a pipeline whose whole point is to be
# launched repeatedly; once a day catches a fix the morning after it lands, which is the timescale
# that actually matters here.
UPDATE_INTERVAL="${SLIDR_UPDATE_INTERVAL:-86400}"
UPDATE_STAMP="${SCRIPT_DIR}/.slidr_update_check"

# Run a command, killing it after `secs` if it has not finished. `timeout(1)` would be the obvious
# tool, but it is GNU coreutils and absent from a stock macOS, where this script also has to run.
# Returns 124 on timeout, mirroring timeout's own convention.
run_with_timeout() {
    local secs="$1"; shift
    "$@" &
    local pid=$! tenths=0
    while kill -0 "$pid" 2>/dev/null; do
        if (( tenths >= secs * 10 )); then
            kill -TERM "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 124
        fi
        sleep 0.1
        tenths=$(( tenths + 1 ))
    done
    wait "$pid"
}

# Name of the upstream branch this checkout tracks (e.g. `origin/main`), or nothing when there is
# none -- a detached HEAD, or a branch never pushed. Both are legitimate states to run from, so
# callers treat an empty answer as "cannot check" rather than as an error.
upstream_branch() {
    git -C "$SCRIPT_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true
}

# True if this checkout is a git working tree with an upstream to compare against. A tarball
# extraction or a copied directory is neither, and must not be nagged about updates it cannot apply.
can_check_updates() {
    git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
    [[ -n "$(upstream_branch)" ]] || return 1
}

# Tell the user, once a day, when the checkout is behind its upstream -- and nothing else. This is a
# notice, never a prompt: ./slidr submits Slurm jobs and creates VMs from scripts and cron entries
# where nothing is watching stdin, and a launcher that blocks on a y/n would hang them. The action
# stays explicit and is named in the message (`./slidr --update`).
#
# Every failure is silent. The check is a convenience running alongside the real work, so a login
# node with no route to github.com, an expired credential or a missing remote must cost a warning at
# most, never a run. Set SLIDR_NO_UPDATE_CHECK=1 to skip it entirely.
update_check() {
    [[ -n "${SLIDR_NO_UPDATE_CHECK:-}" ]] && return 0
    can_check_updates || return 0

    # Skip if the last check is younger than the interval. The stamp is touched before the fetch
    # rather than after it, so an unreachable remote backs off for the full interval too instead of
    # retrying -- and paying the timeout -- on every launch.
    if [[ -f "$UPDATE_STAMP" ]]; then
        local last now
        last="$(cat "$UPDATE_STAMP" 2>/dev/null || echo 0)"
        now="$(date +%s)"
        [[ "$last" =~ ^[0-9]+$ ]] || last=0
        (( now - last < UPDATE_INTERVAL )) && return 0
    fi
    date +%s > "$UPDATE_STAMP" 2>/dev/null || true

    local upstream remote
    upstream="$(upstream_branch)"
    remote="${upstream%%/*}"
    run_with_timeout 10 git -C "$SCRIPT_DIR" fetch --quiet "$remote" 2>/dev/null || return 0

    local behind ahead
    behind="$(git -C "$SCRIPT_DIR" rev-list --count "HEAD..${upstream}" 2>/dev/null || echo 0)"
    ahead="$(git -C "$SCRIPT_DIR" rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)"
    (( behind > 0 )) || return 0

    # A version bump is worth naming when there is one, but most updates are fixes that never touch
    # it, so the commit count is what the message leads with.
    local local_version remote_version
    local_version="$(extract_version < "${SCRIPT_DIR}/pyproject.toml" 2>/dev/null || true)"
    remote_version="$(git -C "$SCRIPT_DIR" show "${upstream}:pyproject.toml" 2>/dev/null | extract_version || true)"

    echo "──────────────────────────────────────────────────────────────────────" >&2
    if [[ -n "$remote_version" && "$remote_version" != "$local_version" ]]; then
        echo "A newer slidr is available: ${local_version:-unknown} → ${remote_version} (${behind} commit(s) behind ${upstream})" >&2
    else
        echo "This slidr checkout is ${behind} commit(s) behind ${upstream}" >&2
    fi
    git -C "$SCRIPT_DIR" log --oneline --no-decorate -3 "HEAD..${upstream}" 2>/dev/null | sed 's/^/  /' >&2
    (( behind > 3 )) && echo "  ... and $(( behind - 3 )) more" >&2
    if (( ahead > 0 )); then
        echo "Update with: git pull --rebase   (this checkout also has ${ahead} local commit(s), so --update will not fast-forward)" >&2
    else
        echo "Update with: ./slidr --update" >&2
    fi
    echo "Set SLIDR_NO_UPDATE_CHECK=1 to silence this check." >&2
    echo "──────────────────────────────────────────────────────────────────────" >&2
    return 0
}

# Pull the newest slidr from GitHub. The built-in the notice above points at, so updating is one
# command from the same entry point everything else runs through, rather than remembering which
# directory to git pull in.
#
# Fast-forward only, and refused outright on a dirty tree. Both keep this from being a command that
# can lose work: a merge or a rebase here could conflict halfway and leave the checkout in a state
# the operator did not ask for and may not know how to leave, in the middle of trying to start a run.
do_update() {
    if ! git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "[ERROR]: ${SCRIPT_DIR} is not a git checkout, so there is nothing to update from" >&2
        echo "Troubleshooting:" >&2
        echo " • Install slidr by cloning it: \`git clone https://github.com/kabanovskyd/slidr\`" >&2
        echo " • A downloaded/copied directory has no link to the repository and must be re-cloned" >&2
        exit 1
    fi

    local upstream
    upstream="$(upstream_branch)"
    if [[ -z "$upstream" ]]; then
        echo "[ERROR]: this checkout tracks no upstream branch, so there is nothing to pull from" >&2
        echo "Troubleshooting:" >&2
        echo " • On a detached HEAD, check out a branch first: \`git checkout main\`" >&2
        echo " • On a local-only branch, set its upstream: \`git branch --set-upstream-to=origin/main\`" >&2
        exit 1
    fi

    # Local modifications are NOT a blanket refusal, because the most likely one is unavoidable:
    # config/config.yaml is tracked and every user has to edit it to run anything at all, so refusing
    # on a dirty tree would refuse almost every real checkout and make this command useless. Git
    # already draws the line in exactly the right place -- a fast-forward keeps modifications to files
    # the update does not touch, and aborts before overwriting ones it does -- so the decision is left
    # to it, and this only reports what is being carried across.
    local dirty
    dirty="$(git -C "$SCRIPT_DIR" status --porcelain --untracked-files=no 2>/dev/null || true)"
    if [[ -n "$dirty" ]]; then
        echo "Local changes are kept, unless the update needs the same file:"
        echo "$dirty" | sed 's/^/  /'
        echo ""
    fi

    local before after
    before="$(git -C "$SCRIPT_DIR" rev-parse HEAD)"
    echo "Updating slidr from ${upstream}..."
    if ! git -C "$SCRIPT_DIR" pull --ff-only --quiet; then
        echo "" >&2
        echo "[ERROR]: could not fast-forward to ${upstream}" >&2
        echo "Troubleshooting:" >&2
        echo " • git's own error is above -- it names the real cause" >&2
        if [[ -n "$dirty" ]]; then
            echo " • Local edits to a file the update also changes will block it. Set them aside and retry:" >&2
            echo "     \`git -C ${SCRIPT_DIR} stash\` → \`./slidr --update\` → \`git -C ${SCRIPT_DIR} stash pop\`" >&2
            echo " • For config/config.yaml specifically, keeping your copy is usually right: stash, update, pop, then re-apply any new fields by hand" >&2
        fi
        echo " • If this checkout has local commits, they have to be rebased by hand: \`git pull --rebase\`" >&2
        echo " • If the branch was rewritten upstream, re-clone rather than forcing a merge here" >&2
        exit 1
    fi
    after="$(git -C "$SCRIPT_DIR" rev-parse HEAD)"

    if [[ "$before" == "$after" ]]; then
        echo "Already up to date ($(print_version_string))."
        exit 0
    fi

    echo ""
    git -C "$SCRIPT_DIR" log --oneline --no-decorate "${before}..${after}" | sed 's/^/  /'
    echo ""
    echo "Updated to $(print_version_string)."
    # Dependencies are not synced here on purpose: `uv run` (local runs) and the explicit `uv sync`
    # in the --slurm path both do it at launch, so the next run picks up a changed pyproject.toml
    # without this command needing network access to PyPI or a working toolchain to succeed.
    echo "Dependency changes, if any, are applied by the next run."
    # a check has effectively just happened, so do not repeat it on the next launch
    date +%s > "$UPDATE_STAMP" 2>/dev/null || true
    exit 0
}

# The version string alone, for messages that embed it. print_version() exits, so it cannot be used.
print_version_string() {
    local version
    version="$(extract_version < "${SCRIPT_DIR}/pyproject.toml" 2>/dev/null || true)"
    echo "version ${version:-unknown}"
}

# ensure uv is installed and on PATH (installs into $HOME/.local/slidr on first use)
ensure_uv() {
    # UV_INSTALL_DIR is the directory uv's binary is placed in directly (uv's default is
    # ~/.local/bin, a leaf bindir), so the installed binary lands at $HOME/.local/slidr/uv --
    # add that exact directory to PATH, not a nonexistent .../slidr/bin subdirectory
    mkdir -p "$HOME/.local/slidr"
    export PATH="$HOME/.local/slidr:$PATH"
    if ! command -v uv &> /dev/null; then
        echo "Installing uv..."
        if ! curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR="$HOME/.local/slidr" sh; then
            echo "[ERROR]: uv installation failed" >&2
            echo "Troubleshooting:" >&2
            echo " • The installer is fetched with curl, so this usually means no network access or a proxy blocking https://astral.sh" >&2
            echo " • Install uv manually: https://docs.astral.sh/uv/getting-started/installation/" >&2
            echo " • Or install it with pipx/pip: \`pipx install uv\`" >&2
            echo " • Check there is free space and write permission on ${HOME}/.local/slidr" >&2
            exit 1
        fi
        export PATH="$HOME/.local/slidr:$PATH"
        echo "uv installed to ${HOME}/.local/slidr/uv"
    fi
}

# Roots a conda/mamba installation is plausibly already at, searched before installing another one.
# `$HOME/miniforge3` is where this script puts it; `/opt/miniforge3` is where the --gcp VM image ships
# it; the rest are what a user or a cluster module is likely to have installed first. CONDA_ROOT and
# MAMBA_ROOT_PREFIX come first so an explicit choice wins over a guess.
CONDA_SEARCH_ROOTS=(
    "${CONDA_ROOT:-}"
    "${MAMBA_ROOT_PREFIX:-}"
    "$HOME/miniforge3"
    "$HOME/mambaforge"
    "$HOME/miniconda3"
    "$HOME/anaconda3"
    "/opt/miniforge3"
    "/opt/conda"
)

# Print the root of an existing conda installation, or return 1. Existence is judged by a runnable
# bin/conda rather than by the directory being there at all: a half-finished or interrupted install
# leaves the directory without the binary, and treating that as "installed" would send the pipeline on
# to fail later at `mamba env create` instead of repairing it here.
find_conda_root() {
    local root
    for root in "${CONDA_SEARCH_ROOTS[@]}"; do
        [[ -n "$root" && -x "${root}/bin/conda" ]] && { printf '%s' "$root"; return 0; }
    done
    return 1
}

# ensure conda is installed (the pipeline uses it for the R / CellBender environments)
ensure_conda() {
    # already usable in this shell
    command -v conda &> /dev/null && return 0

    # Installed, but not on PATH -- which is the normal state, not an edge case. The install below adds
    # conda to PATH for the rest of that one script run and calls `conda init bash`, which writes
    # ~/.bashrc; a later `./slidr` runs in a non-interactive shell that never sources it, so conda is
    # invisible again. Without this lookup every subsequent run tried to reinstall, and the Miniforge
    # installer refuses a prefix that already exists -- so the pipeline failed with "the Miniforge
    # installer failed" while a perfectly good conda sat in $HOME/miniforge3.
    local existing_root
    if existing_root="$(find_conda_root)"; then
        export PATH="${existing_root}/bin:$PATH"
        return 0
    fi

    echo "Installing Miniforge..."

    # detect OS
    local OS ARCH INSTALLER
    OS=$(uname -s)
    ARCH=$(uname -m)

    if [ "$OS" = "Linux" ]; then
        INSTALLER="Miniforge3-Linux-${ARCH}.sh"
    elif [ "$OS" = "Darwin" ]; then
        INSTALLER="Miniforge3-MacOSX-${ARCH}.sh"
    else
        echo "[ERROR]: cannot install Miniforge automatically on this platform: $OS" >&2
        echo "Troubleshooting:" >&2
        echo " • Automatic installation supports Linux and macOS (Darwin) only" >&2
        echo " • Install Miniforge yourself and make sure \`conda\` is on PATH: https://github.com/conda-forge/miniforge#install" >&2
        echo " • conda/mamba is needed for the R and CellBender environments; the rest of the pipeline uses uv" >&2
        exit 1
    fi

    # Into a temp directory, not the working directory: a failed install used to leave a ~100 MB
    # Miniforge3-*.sh sitting in the repository root, untracked and easy to commit by accident.
    local tmpdir
    tmpdir="$(mktemp -d)"

    # download and run the installer. Both steps are checked explicitly: under `set -e` a bare
    # failure here aborts the script with no output at all, leaving the user with no idea that
    # it was conda -- not their run -- that failed.
    if ! curl -fL -o "${tmpdir}/${INSTALLER}" "https://github.com/conda-forge/miniforge/releases/latest/download/${INSTALLER}"; then
        rm -rf "$tmpdir"
        echo "[ERROR]: could not download the Miniforge installer (${INSTALLER})" >&2
        echo "Troubleshooting:" >&2
        echo " • This usually means no network access or a proxy blocking https://github.com" >&2
        echo " • Install Miniforge yourself and make sure \`conda\` is on PATH: https://github.com/conda-forge/miniforge#install" >&2
        echo " • On a cluster, check whether conda/mamba is already available as a module (e.g. \`module load miniforge\`)" >&2
        exit 1
    fi

    # `-u` when the prefix exists. Reaching this line means find_conda_root found no runnable
    # bin/conda, so anything at the prefix is a half-written or broken install rather than one worth
    # keeping -- and the installer refuses an existing prefix outright without it, which is precisely
    # how an interrupted first install used to wedge every later run.
    local prefix="$HOME/miniforge3"
    local install_args=(-b -p "$prefix")
    if [[ -e "$prefix" ]]; then
        echo "  ${prefix} already exists but has no working conda; repairing it in place"
        install_args=(-b -u -p "$prefix")
    fi

    if ! bash "${tmpdir}/${INSTALLER}" "${install_args[@]}"; then
        echo "[ERROR]: the Miniforge installer failed" >&2
        echo "Troubleshooting:" >&2
        echo " • Check there is free space and write permission in ${HOME}" >&2
        echo " • Remove a broken install and retry: \`rm -rf ${prefix}\`" >&2
        echo " • Or install Miniforge yourself anywhere and put its bin/ on PATH, or point CONDA_ROOT at it" >&2
        echo " • Installer left for inspection: ${tmpdir}/${INSTALLER}" >&2
        exit 1
    fi
    rm -rf "$tmpdir"

    # add to PATH for the rest of this script
    export PATH="${prefix}/bin:$PATH"

    # Convenience for the operator's own interactive shell, and nothing more: it edits ~/.bashrc, which
    # a later non-interactive `./slidr` never reads. Future runs find this install through
    # find_conda_root instead, so a failure here is not worth stopping a run over.
    conda init bash >/dev/null 2>&1 || true

    if ! command -v conda &> /dev/null; then
        echo "[ERROR]: Miniforge reported success, but conda is still not runnable at ${prefix}/bin/conda" >&2
        echo "Troubleshooting:" >&2
        echo " • Check the install: \`ls -l ${prefix}/bin/conda\`" >&2
        echo " • Remove it and retry: \`rm -rf ${prefix}\`" >&2
        exit 1
    fi
    echo "Miniforge installed at ${prefix} (later runs find it automatically)."
}

# --- defaults ---
PROJECT=""
ZONE="us-central1-a"
MACHINE_TYPE="n1-standard-16"
DISK_SIZE="200GB"
# Where inputs are staged FROM always comes from `paths.input_path`: ./slidr only ever runs from a
# checkout that has a config, and the VM / compute node is handed the location as a parameter. The
# flags say *whether* to stage (--gcp implies it, --stage-gcs requests it), never where from -- which
# is also what makes it safe for that one field to mean a local directory the rest of the time.
INPUT_GCS=""
# set by --stage-gcs: intent to fetch this run's inputs from GCS rather than the local filesystem
STAGE_GCS=""
BCL_ID=""
FASTQ_DIR=""
METADATA_PATH=""
SLIDR_ARGS=()
# tracks whether the caller named a pipeline stage; --gcp/--slurm/--fastqs/--force say *how* or
# *on what* to run, not *what* to run, so they must not suppress the --run-all default
STAGE_FLAG=""
GCP=""
GPU=""
# GCE accelerator type attached when --gpu is passed without an explicit one. T4 is the cheapest
# card with enough memory for CellBender and is available in most zones. Kept in its own variable so
# the validation error below can still name the default after GPU_TYPE has been overwritten.
GPU_TYPE_DEFAULT="nvidia-tesla-t4"
GPU_TYPE="$GPU_TYPE_DEFAULT"
# Whether a type was actually typed, rather than inferred by comparing GPU_TYPE to the default. The
# comparison is wrong in one case that is easy to hit by accident: `--slurm --gpu nvidia-tesla-t4`
# names a type explicitly but matches the default, and would be forwarded as a bare `--gres=gpu:1`
# with the type silently dropped. Which is arguably the better outcome -- a GCE name is meaningless
# to Slurm -- but it should be a decision the caller can see, not one made by string equality.
GPU_TYPE_EXPLICIT=""
SLURM=""
PARTITION=""
TIME="24:00:00"
WORKDIR=""

# --- parse arguments ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bcl)             BCL_ID="$2";       shift 2 ;;
    # -sl has no canonical_flag entry, and needs none: --slurm is consumed here rather than forwarded
    # (workflow/main.py has no --slurm flag -- scheduler dispatch is entirely a wrapper concern), so
    # it never reaches the pass-through array that canonicalization exists to normalize.
    -sl|--slurm)       SLURM=true; shift ;;
    -gc|--gcp)         GCP=true; SLIDR_ARGS+=("$(canonical_flag "$1")"); shift ;;
    # --gpu takes an optional accelerator type. The next argument is consumed as the type only when
    # it is not itself a flag, so a bare `--gpu` (or `--gpu --run-all`) keeps working and defaults to
    # $GPU_TYPE below rather than swallowing the following flag as a type name.
    --gpu)             GPU=true
                       if [[ $# -gt 1 && "$2" != -* ]]; then GPU_TYPE="$2"; GPU_TYPE_EXPLICIT=true; shift 2; else shift; fi ;;
    --project)         PROJECT="$2";      shift 2 ;;
    --zone)            ZONE="$2";         shift 2 ;;
    --machine)         MACHINE_TYPE="$2"; shift 2 ;;
    --disk)            DISK_SIZE="$2";    shift 2 ;;
    --partition)       PARTITION="$2";    shift 2 ;;
    --time)            TIME="$2";         shift 2 ;;
    --workdir)         WORKDIR="$2";      shift 2 ;;
    # pass-through pipeline flags that take a value. --fastqs's is optional: a bare one means "the
    # FASTQs are in `paths.input_path`", so the next argument is consumed only when it is not itself
    # a flag (same rule as --gpu above).
    -fq|--fastqs)      SLIDR_ARGS+=("$(canonical_flag "$1")")
                       if [[ $# -gt 1 && "$2" != -* ]]; then
                           FASTQ_DIR="$2"; SLIDR_ARGS+=("$2"); shift 2
                       else
                           shift
                       fi ;;
    -md|--metadata)    METADATA_PATH="$2"; SLIDR_ARGS+=("$(canonical_flag "$1")" "$2"); shift 2 ;;
    # pass-through stage-selection flags
    -ra|--run-all|-mf|--mkfastq|-ct|--count|-cb|--cellbender|-sc|--spatial-count|-sa|--spatial-analysis)
                       STAGE_FLAG=true; SLIDR_ARGS+=("$(canonical_flag "$1")"); shift ;;
    # pass-through boolean modifier flags. --stage-gcs asks the pipeline to pull
    # reference_path/puck_path/raw_barcodes_path out of GCS; --gcp already implies it, so this is
    # for staging on a cluster that is not a GCE VM.
    -nb|--no-cellbender|-f|--force)
                       SLIDR_ARGS+=("$(canonical_flag "$1")"); shift ;;
    # --stage-gcs is both forwarded (the pipeline stages reference/puck/barcode paths) and acted on
    # here (a --slurm run stages its config, key and sequencing data), so it is captured as well as
    # passed through.
    -sg|--stage-gcs)   STAGE_GCS=true; SLIDR_ARGS+=("$(canonical_flag "$1")"); shift ;;
    # handled inline (and before the --bcl check below) so `./slidr --version` works on its own
    -v|--version)      print_version ;;
    -h|--help)         usage ;;
    -u|--update)       do_update ;;
    *)                 echo "[ERROR]: unknown argument: $1" >&2
                       echo " • Check the flag against the list below; pipeline flags are passed through to workflow/main.py unchanged" >&2
                       echo " • A value-taking flag needs its value as a separate argument (e.g. \`--fastqs /path\`, not \`--fastqs=/path\`)" >&2
                       usage ;;
  esac
done

[[ "$GCP" == true ]] && [[ "$SLURM" == true ]] && {
    echo "[ERROR]: both --gcp and --slurm flags are provided - please choose one" >&2
    echo " • --gcp creates a GCE VM and runs there; --slurm submits a batch job to this cluster" >&2
    echo " • Drop both to run locally in the current shell" >&2
    usage
}
[[ -z "$BCL_ID" ]] && {
    echo "[ERROR]: --bcl is required" >&2
    echo " • Pass the BCL run ID, e.g. \`--bcl 20240101_RUNID\`" >&2
    echo " • It must match a value in the \`BCL\` column of your metadata sheet" >&2
    echo " • Give the ID itself, not a path -- the run folder is resolved as <input_path>/<BCL_ID>" >&2
    usage
}

# Say so if a newer slidr is out. Placed after the arguments validate, so a mistyped command gets its
# own error rather than an update notice above it, and before any of the work starts, so the notice is
# read while there is still the option of updating and re-launching rather than hours later. Writes to
# stderr and never fails the run -- see update_check.
update_check

# --fastqs supplies already-demultiplexed reads; --mkfastq asks for BCLs to be demultiplexed.
# main.py rejects the combination too, but catching it here avoids creating a billable VM first.
if [[ -n "$FASTQ_DIR" ]] && printf '%s\n' "${SLIDR_ARGS[@]}" | grep -qx -- --mkfastq; then
    echo "[ERROR]: --fastqs and --mkfastq are mutually exclusive - choose one" >&2
    echo "Troubleshooting:" >&2
    echo " • --mkfastq asks for BCLs to be demultiplexed; --fastqs asserts that already happened" >&2
    echo " • Drop --fastqs to demultiplex the BCLs under \`paths.input_path\`" >&2
    echo " • Drop --mkfastq to run the downstream stages on the FASTQs you provided" >&2
    exit 1
fi

# run everything by default: only a stage flag suppresses this, so `--fastqs DIR` (or `--gcp`) on
# its own still runs the pipeline rather than silently doing nothing
[[ -z "$STAGE_FLAG" ]] && SLIDR_ARGS+=(--run-all)

# Resolve the input location from the config. Under --gcp/--stage-gcs this is the GCS prefix to stage
# from; for a local run it is a directory and nothing here reads it. Trailing slashes are stripped
# because everything downstream appends object names directly to it, and a GCS name containing '//' is
# a different object.
INPUT_GCS="$(strip_trailing_slashes "$(read_config_scalar input_path)")"

# Where results go, and -- for --gcp -- where this checkout's config.yaml is uploaded so the VM can boot
# from it. Only --gcp reads this; a local or Slurm run leaves the whole question to the pipeline.
OUTPUT_BUCKET="$(strip_trailing_slashes "$(read_config_scalar output_bucket)")"

# Report whether a gs:// name is unused. Mirrors pipeline.gcs_dest_taken, which the pipeline itself uses
# at the end of a run; both have to agree on what "already there" means or a --gcp run would resolve its
# results folder differently from a local or Slurm one.
#
# Exit 0 = free. A non-zero `gcloud storage ls` is only good news when it says "nothing there"; any
# other failure (no credentials, no read access) says nothing about whether the name is free, so it is
# reported and the name is treated as free. Nothing is lost by that here: the very next thing the caller
# does is write the config into this folder, which fails loudly for the same reason.
gcs_name_free() {
    local uri="$1" out rc=0
    out="$(gcloud storage ls "$uri" 2>&1)" || rc=$?

    # A zero exit with output means the name is in use; a zero exit with none means an empty listing,
    # which only a placeholder object produces. Written as explicit returns rather than falling through
    # on the `[[ ]]` status so `set -e` cannot act on it if this is ever called outside an `if`.
    if [[ $rc -eq 0 ]]; then
        [[ -z "${out//[[:space:]]/}" ]] && return 0
        return 1
    fi
    case "$out" in
        *"matched no objects"*|*"not found"*) return 0 ;;
    esac

    echo "[WARNING]: could not check whether ${uri} already exists (\`gcloud storage ls\` exited ${rc})" >&2
    echo "${out}" | tail -3 | sed 's/^/  /' >&2
    echo "  Treating the name as unused; the config upload below will fail if the bucket is unreadable" >&2
    return 0
}

# First unused folder for a run's results: <bucket>/<BCL_ID>, else <BCL_ID>_2, _3, ... This is the same
# rule as pipeline.unique_gcs_dest, applied here because a --gcp run needs the answer *before* the VM
# exists -- the config the VM boots from is uploaded into that folder, which both puts it beside the
# results it produced and stakes a claim on the name.
unique_output_dest() {
    local base="$1" candidate suffix
    if gcs_name_free "$base"; then
        printf '%s' "$base"
        return
    fi
    for (( suffix = 2; suffix <= 100; suffix++ )); do
        candidate="${base}_${suffix}"
        if gcs_name_free "$candidate"; then
            printf '%s' "$candidate"
            return
        fi
    done
    # 100 numbered folders already present is far likelier to be a misconfigured output_bucket than a
    # hundredth re-run, but the run still needs somewhere to go and a timestamp needs no further probing
    printf '%s_%s' "$base" "$(date +%Y%m%d_%H%M%S)"
}

# Sanity-check the accelerator type before it reaches gcloud/sbatch, in whichever of the two naming
# schemes applies. Catching a typo here beats a VM-creation failure minutes later, or (on Slurm) a job
# that sits pending forever against a resource the cluster has never heard of.
#
# The two schemes are genuinely different and the check has to follow the destination rather than pick
# one. GCE accelerator names are lowercase alphanumerics and hyphens (nvidia-tesla-t4, nvidia-l4,
# nvidia-a100-80gb). Slurm gres types are whatever a site's gres.conf calls them, and underscores are
# ordinary there -- `a100_80gb` and `rtx_6000` are real names on real clusters, and the GCE-shaped rule
# rejected every one of them, so `--slurm --gpu a100_80gb` failed at this line for a value that the
# gres translation below would have handled correctly.
if [[ "$GPU" == true ]]; then
    if [[ "$SLURM" == true ]]; then
        GPU_TYPE_RE='^[a-z0-9][a-z0-9_-]*$'
        GPU_TYPE_HINT=" • Slurm gres types come from your cluster's gres.conf, e.g. a100, v100, a100_80gb -- check with \`sinfo -o '%G'\`"
    else
        GPU_TYPE_RE='^[a-z0-9][a-z0-9-]*$'
        GPU_TYPE_HINT=" • GCE accelerator names are lowercase letters, digits and hyphens, e.g. nvidia-tesla-t4, nvidia-l4, nvidia-a100-80gb"
    fi
    if ! [[ "$GPU_TYPE" =~ $GPU_TYPE_RE ]]; then
        echo "[ERROR]: invalid GPU type: '${GPU_TYPE}'" >&2
        echo "Troubleshooting:" >&2
        echo "$GPU_TYPE_HINT" >&2
        if [[ "$SLURM" == true ]]; then
            echo " • A GCE accelerator name (nvidia-tesla-t4) is not a gres type; Slurm will not recognise it" >&2
        else
            echo " • List what your zone offers: \`gcloud compute accelerator-types list --filter=\"zone:${ZONE}\"\`" >&2
        fi
        echo " • Pass a bare \`--gpu\` for one GPU of no particular type" >&2
        exit 1
    fi
fi

if [[ "$GCP" == true ]]; then

    # Fail fast, before creating a billable VM, if the locations it needs are missing. A fresh VM has no
    # filesystem of ours at all, so --gcp always stages -- there is no non-staging mode to fall back to
    # and hence no flag to opt in with. Without these checks a bad config produces a VM that boots, fails
    # to find its own inputs, and self-deletes: a silent, costly no-op instead of a clear local error.
    #
    # The config file comes first because every check below reads it: a --gcp run no longer merely
    # consults it for a few values, it uploads the file itself for the VM to boot from.
    if [[ ! -f "$LOCAL_CONFIG" ]]; then
        echo "[ERROR]: no config file at ${LOCAL_CONFIG}, and a --gcp run uploads that file for the VM to boot from" >&2
        echo "Troubleshooting:" >&2
        echo " • Restore it from the repository (\`git checkout config/config.yaml\`) and fill in the fields for your site" >&2
        echo " • It is read here for \`paths.input_path\` and \`settings.output_bucket\`, then uploaded as-is" >&2
        exit 1
    fi
    if [[ -z "$INPUT_GCS" ]]; then
        echo "[ERROR]: \`paths.input_path\` is not set, so a --gcp run has nowhere to stage its inputs from" >&2
        echo "Troubleshooting:" >&2
        echo " • Set \`paths.input_path\` in ${LOCAL_CONFIG} to the GCS prefix holding this run's inputs" >&2
        echo " • That prefix must already hold the ${BCL_ID} data folder -- upload it before launching" >&2
        echo " • config.yaml is not uploaded by hand any more: ${LOCAL_CONFIG} is copied to the run's output folder at launch" >&2
        echo " • The VM is handed these locations as instance metadata and downloads everything else itself" >&2
        exit 1
    fi
    # A --gcp run always stages, so this field has to be the bucket rather than a local directory --
    # the VM has no filesystem of ours to point at. Caught here rather than on the VM, which would
    # boot, fail to download its own config and self-delete.
    if [[ "$INPUT_GCS" != gs://* ]]; then
        echo "[ERROR]: --gcp needs \`paths.input_path\` to be a gs:// URL, but it is: '${INPUT_GCS}'" >&2
        echo "Troubleshooting:" >&2
        echo " • A fresh VM cannot see this machine's filesystem, so a --gcp run always stages from a bucket" >&2
        echo " • Set \`paths.input_path\` in ${LOCAL_CONFIG} to the prefix holding the ${BCL_ID} run folder" >&2
        echo " • Write the full URL including the scheme, e.g. gs://my-bucket/inputs" >&2
        echo " • A local directory there is only valid for a run without --gcp/--stage-gcs" >&2
        exit 1
    fi
    # The config the VM boots from is this checkout's own, uploaded into the folder the run's results go
    # to -- so `settings.output_bucket` is what a --gcp run is launched *from*, not just where it ends up.
    # It was already required in practice: the VM self-deletes, so without it a run threw its results away.
    if [[ -z "$OUTPUT_BUCKET" ]]; then
        echo "[ERROR]: \`settings.output_bucket\` is not set, so a --gcp run has nowhere to put its config or its results" >&2
        echo "Troubleshooting:" >&2
        echo " • Set \`settings.output_bucket\` in ${LOCAL_CONFIG} to a GCS bucket or prefix you can write to" >&2
        echo " • ${LOCAL_CONFIG} is uploaded to <output_bucket>/${BCL_ID}/config.yaml at launch, and the VM boots from that copy" >&2
        echo " • The VM self-deletes when it finishes, so this is also the only place its results survive" >&2
        exit 1
    fi
    if [[ "$OUTPUT_BUCKET" == /* || "$OUTPUT_BUCKET" == '~'* ]]; then
        echo "[ERROR]: --gcp needs \`settings.output_bucket\` to be a GCS location, but it is a local path: '${OUTPUT_BUCKET}'" >&2
        echo "Troubleshooting:" >&2
        echo " • A fresh VM cannot see this machine's filesystem, and it self-deletes when it finishes" >&2
        echo " • Write it as gs://my-bucket/results, or as a bare my-bucket/results" >&2
        exit 1
    fi
    # A Google Sheet metadata source needs the service-account key, and the VM reads it straight out of
    # the bucket rather than having one staged onto its disk -- so anything here that is not a gs:// object
    # names a key the VM will not have. An unset field is rejected for exactly the same reason a local
    # path is, and is the likelier of the two mistakes: both leave a VM that boots, fails to open the
    # sheet and self-deletes, which is the outcome this check exists to prevent, so guarding only the
    # non-empty case would let the worse one through. `--metadata` can override the source, so only
    # complain when the source this run will actually read is a sheet.
    CONFIG_METADATA_SRC="$(read_config_scalar metadata_source)"
    CONFIG_AUTH_KEY="$(read_config_scalar auth_key_path)"
    EFFECTIVE_METADATA_SRC="${METADATA_PATH:-$CONFIG_METADATA_SRC}"
    if [[ "$EFFECTIVE_METADATA_SRC" == *docs.google.com/spreadsheets* && "$CONFIG_AUTH_KEY" != gs://* ]]; then
        if [[ -z "$CONFIG_AUTH_KEY" ]]; then
            echo "[ERROR]: \`paths.auth_key_path\` is not set, and a --gcp run reading its metadata from a Google Sheet needs the key as a gs:// object" >&2
        else
            echo "[ERROR]: \`paths.auth_key_path\` must be a gs:// object for a --gcp run reading its metadata from a Google Sheet, but is: '${CONFIG_AUTH_KEY}'" >&2
        fi
        echo "Troubleshooting:" >&2
        echo " • Upload the key once and point the field at it: \`auth_key_path: gs://my-bucket/secrets/auth_key.json\`" >&2
        echo " • The pipeline reads it with \`gcloud storage cat\` when it opens the sheet, so it is never written to the VM's disk" >&2
        echo " • Nothing local can work: the VM is created fresh, with no key of its own and no copy of this machine's filesystem" >&2
        echo " • Or export the metadata to a .tsv/.csv in the bucket and pass it with --metadata, which needs no key at all" >&2
        exit 1
    fi
    if [[ -z "$PROJECT" ]]; then
        echo "[ERROR]: --project is required for a --gcp run" >&2
        echo "Troubleshooting:" >&2
        echo " • Pass your GCP project ID: \`--project my-project-id\`" >&2
        echo " • List the projects you can use: \`gcloud projects list\`" >&2
        echo " • The project must have a \`slidr-runner\` service account and the slidr-vm-image7 VM image" >&2
        exit 1
    fi
    # BCL_ID/INPUT_GCS/OUTPUT_BUCKET are embedded into gcloud's comma/equals-delimited --metadata value
    # below, and so is --fastqs (via SLIDR_ARGS_STR); a ',' or '=' in any of them would silently split
    # into bogus metadata keys or truncate a value.
    if [[ "$BCL_ID" == *[,=]* || "$INPUT_GCS" == *[,=]* || "$OUTPUT_BUCKET" == *[,=]* || "$FASTQ_DIR" == *[,=]* || "$METADATA_PATH" == *[,=]* ]]; then
        echo "[ERROR]: --bcl, --fastqs, --metadata, \`paths.input_path\` and \`settings.output_bucket\` must not contain ',' or '=' characters" >&2
        echo "Troubleshooting:" >&2
        echo " • These values are passed to the VM through GCE instance metadata, which is itself comma- and equals-delimited" >&2
        echo " • Rename the offending path or BCL folder to remove the character, then re-launch" >&2
        echo " • Received: --bcl '${BCL_ID}' --fastqs '${FASTQ_DIR}' --metadata '${METADATA_PATH}', input_path '${INPUT_GCS}', output_bucket '${OUTPUT_BUCKET}'" >&2
        exit 1
    fi

    command -v gcloud >/dev/null 2>&1 || {
        echo "[ERROR]: --gcp needs the gcloud CLI, but it is not on PATH" >&2
        echo "Troubleshooting:" >&2
        echo " • Install the Google Cloud CLI: https://cloud.google.com/sdk/docs/install" >&2
        echo " • It is needed to upload the config, create the VM and stream its logs back" >&2
        exit 1
    }

    SERVICE_ACCOUNT="slidr-runner@${PROJECT}.iam.gserviceaccount.com"
    VM_NAME="slidr-run-$(date +%s)-${RANDOM}"

    # --------------------------------------------------------------------------------------- #
    #        resolve the run's output folder, and seed it with the config the VM boots from     #
    # --------------------------------------------------------------------------------------- #
    #
    # This is what removes the old manual step. config.yaml used to have to be uploaded to
    # `paths.input_path` by hand, which meant a second copy of the file living in a bucket: edit the
    # local one and the VM silently ran with the stale bucket copy, and the two had no reason to ever
    # agree. Now the file the operator just edited *is* the file the VM boots from.
    #
    # It goes into the run's own results folder rather than a launch-staging area, so each folder in the
    # bucket records the configuration that produced it. Resolving that folder here rather than letting
    # the run do it at the end has two further effects worth knowing:
    #   - writing config.yaml into it claims the name, so two --gcp launches of one BCL cannot both
    #     resolve to the same folder the way two locally-resolved runs finishing together can
    #   - the pipeline must be told the answer (SLIDR_OUTPUT_DEST, via instance metadata) instead of
    #     re-deciding, since by then the config sitting there makes the folder look taken
    OUTPUT_BUCKET_URI="$OUTPUT_BUCKET"
    [[ "$OUTPUT_BUCKET_URI" == gs://* ]] || OUTPUT_BUCKET_URI="gs://${OUTPUT_BUCKET_URI}"
    OUTPUT_DEST="$(unique_output_dest "${OUTPUT_BUCKET_URI}/${BCL_ID}")"
    CONFIG_GCS="${OUTPUT_DEST}/config.yaml"

    if [[ "$OUTPUT_DEST" != "${OUTPUT_BUCKET_URI}/${BCL_ID}" ]]; then
        echo "${OUTPUT_BUCKET_URI}/${BCL_ID} already holds results; this run will use ${OUTPUT_DEST}"
    fi

    echo "Uploading ${LOCAL_CONFIG} to ${CONFIG_GCS}..."
    gcloud storage cp "$LOCAL_CONFIG" "$CONFIG_GCS" || {
        echo "[ERROR]: could not upload the config to ${CONFIG_GCS}, so the VM would have nothing to boot from" >&2
        echo "Troubleshooting:" >&2
        echo " • gcloud's own error is above -- it names the real cause" >&2
        echo " • Check you are authenticated: \`gcloud auth print-access-token\`" >&2
        echo " • Check the bucket exists and you can write to it: \`gcloud storage ls ${OUTPUT_BUCKET_URI}\`" >&2
        echo " • Check \`settings.output_bucket\` in ${LOCAL_CONFIG} names a bucket you have Storage Object Admin on" >&2
        echo " • No VM was created, so this costs nothing to retry" >&2
        exit 1
    }

    # Serialize the SLIDR_ARGS array into a single shell-quoted string so it
    # survives the round-trip through GCE instance metadata (a flat string)
    # and can be safely reconstituted into an array on the VM.
    SLIDR_ARGS_STR="$(printf '%q ' "${SLIDR_ARGS[@]}")"

    CMD=(
        gcloud compute instances create "${VM_NAME}"
        --zone="${ZONE}"
        --image=slidr-vm-image7
        --machine-type="${MACHINE_TYPE}"
        --network=vpc1
        --subnet=my-subnet-central
        --service-account="${SERVICE_ACCOUNT}"
        --project="${PROJECT}"
        --boot-disk-size="${DISK_SIZE}"
        --boot-disk-type=pd-balanced
        # Narrowest set of scopes the VM actually uses: bucket read/write
        # (staging inputs, uploading outputs), self-delete via the Compute
        # API, and ops-agent log/metric forwarding. IAM roles on the
        # slidr-runner service account still gate what's actually allowed;
        # this just stops a minted token from also carrying access to every
        # other API (BigQuery, Pub/Sub, IAM, etc.) that account could reach.
        --scopes=storage-rw,compute-rw,logging-write,monitoring-write
        --metadata=input-gcs="${INPUT_GCS}",bcl-id="${BCL_ID}",config-gcs="${CONFIG_GCS}",output-dest="${OUTPUT_DEST}",slidr-args="${SLIDR_ARGS_STR}"
        --metadata-from-file=startup-script="${SCRIPT_DIR}/workflow/bash/slidr_gcp.sh"
    )

    if [[ "$GPU" == true ]]; then
        echo "Attaching GPU: ${GPU_TYPE}"
        CMD+=(
            --accelerator="type=${GPU_TYPE},count=1"
            # GPU-attached instances cannot live-migrate, so host maintenance must terminate them
            --maintenance-policy=TERMINATE
        )
    fi

    "${CMD[@]}"

    # VM name on line 1, its project on line 2 -- watch_run.sh needs both to build the Cloud
    # Logging filter, and reading the project back from here is what keeps it out of the script.
    printf '%s\n%s\n' "${VM_NAME}" "${PROJECT}" > "${SCRIPT_DIR}/.last_run"

    echo ""
    echo "VM launched: ${VM_NAME}"
    echo "Config:      ${CONFIG_GCS}"
    echo "Results:     ${OUTPUT_DEST}"
    echo "Pipeline continues running if you disconnect. Reattach with: ./watch_run.sh"
    echo ""

    "${SCRIPT_DIR}/watch_run.sh" "${VM_NAME}" "${PROJECT}"
elif [[ "$SLURM" == true ]]; then

    # run relative-path commands from the repo root regardless of the caller's directory
    cd "$SCRIPT_DIR"

    # A --slurm run stages its inputs from GCS only when --stage-gcs asks it to. Left off, the job
    # reads everything off the local filesystem exactly as before: whether a run is self-staging is
    # stated by the flag, never guessed from whether `paths.input_path` happens to look like a bucket.
    SLURM_STAGE=""
    [[ "$STAGE_GCS" == true ]] && SLURM_STAGE=true

    # Every value read at submit time comes from this checkout's config, staged run or not: a --slurm
    # job always runs with config/config.yaml rather than a copy fetched from the bucket.
    CONFIG_SOURCE="$LOCAL_CONFIG"

    if [[ "$SLURM_STAGE" == true ]]; then
        command -v gcloud >/dev/null 2>&1 || {
            echo "[ERROR]: --slurm --stage-gcs needs the gcloud CLI to stage inputs, but it is not on PATH" >&2
            echo "Troubleshooting:" >&2
            echo " • Many clusters ship it as a module; load it first (e.g. \`module load google-cloud-sdk\`)" >&2
            echo " • Otherwise install it: https://cloud.google.com/sdk/docs/install" >&2
            echo " • Or drop --stage-gcs to run entirely off the local filesystem, with no staging" >&2
            exit 1
        }
        [[ "$INPUT_GCS" == gs://* ]] || {
            echo "[ERROR]: --stage-gcs needs \`paths.input_path\` to be a gs:// URL, but it is: '${INPUT_GCS}'" >&2
            echo "Troubleshooting:" >&2
            echo " • Set \`paths.input_path\` in ${LOCAL_CONFIG} to the prefix holding the ${BCL_ID} data folder" >&2
            echo " • Write the full URL including the scheme, e.g. gs://my-bucket/inputs" >&2
            echo " • A --slurm run needs no config.yaml in the bucket: it runs with ${LOCAL_CONFIG} from this checkout" >&2
            echo " • To read inputs off this cluster's own filesystem instead, drop --stage-gcs and point \`paths.input_path\` at a local directory" >&2
            exit 1
        }

        # Default the staging directory from the config rather than from the checkout. `output_path`
        # is the best available hint at where this cluster keeps large storage, and its parent is the
        # natural staging root -- the job puts data/ and outs/ side by side beneath the workdir, so
        # deriving from `<...>/outs` reproduces the configured output location exactly. Falling back
        # through $SCRATCH (set on most HPC sites) before the checkout means the last resort -- a
        # home-directory quota, which is the wrong place for hundreds of GB -- is rarely reached.
        if [[ -n "$WORKDIR" ]]; then
            WORKDIR_SOURCE="--workdir"
        else
            CONFIG_OUTPUT_PATH="$(read_config_scalar output_path "$CONFIG_SOURCE")"
            CONFIG_WORKDIR=""
            [[ "$CONFIG_OUTPUT_PATH" == /* ]] && CONFIG_WORKDIR="$(dirname "$CONFIG_OUTPUT_PATH")"
            if [[ -n "$CONFIG_WORKDIR" && "$CONFIG_WORKDIR" != "/" && "$CONFIG_WORKDIR" != "." ]]; then
                WORKDIR="$CONFIG_WORKDIR"
                WORKDIR_SOURCE="parent of \`paths.output_path\` in the config"
            elif [[ -n "${SCRATCH:-}" ]]; then
                WORKDIR="${SCRATCH}/slidr"
                WORKDIR_SOURCE="\$SCRATCH"
            else
                WORKDIR="${SCRIPT_DIR}/slidr-work/${BCL_ID}"
                WORKDIR_SOURCE="the repository checkout -- pass --workdir to stage on scratch instead"
            fi
        fi
    elif [[ -n "$WORKDIR" ]]; then
        echo "[ERROR]: --workdir applies to staged runs only; add --stage-gcs too" >&2
        echo "Troubleshooting:" >&2
        echo " • --workdir configures where inputs are staged *to*, so it only means something once there is something to stage" >&2
        echo " • Add \`--stage-gcs\` to turn this into a self-staging run (the location comes from \`paths.input_path\`)" >&2
        echo " • Or drop it: without --stage-gcs the job reads everything off the local filesystem, as configured in config/config.yaml" >&2
        exit 1
    fi

    # Interpolate CPUs and memory (the same values Cellranger/Julia use) to size the allocation.
    # Both staged and unstaged runs read them from this checkout's config, which is the one the job
    # runs with either way.
    CPUS="$(read_config_scalar threads "$CONFIG_SOURCE")"
    MEM="$(read_config_scalar memory "$CONFIG_SOURCE")"
    CPUS="${CPUS:-16}"
    MEM="${MEM:-50}"
    if ! [[ "$CPUS" =~ ^[0-9]+$ ]]; then
        echo "[ERROR]: settings.threads must be a positive integer (got '${CPUS}')" >&2
        echo "Troubleshooting:" >&2
        echo " • This value becomes sbatch's --cpus-per-task, so it has to be a bare integer" >&2
        echo " • Set \`settings.threads\` to e.g. 16, with no quotes, units or inline comment" >&2
        echo " • It is read from ${LOCAL_CONFIG}, which is also the config the job itself runs with" >&2
        exit 1
    fi
    # settings.memory is an integer number of GB per the config schema; append the 'G' suffix
    # Slurm's --mem expects, but pass an already-suffixed value (e.g. 50G, 50000M) through unchanged
    if [[ "$MEM" =~ ^[0-9]+$ ]]; then MEM_ARG="${MEM}G"; else MEM_ARG="$MEM"; fi

    SBATCH_OPTS=(
        --job-name="slidr-${BCL_ID}"
        --cpus-per-task="$CPUS"
        --mem="$MEM_ARG"
        --time="$TIME"
        --chdir="$SCRIPT_DIR"
        --output="${SCRIPT_DIR}/slurm-slidr-${BCL_ID}-%j.out"
    )
    # --partition omitted (uses the cluster default) unless one is given
    [[ -n "$PARTITION" ]] && SBATCH_OPTS+=(--partition="$PARTITION")
    # Request a GPU when --gpu is passed. A type given on the command line is forwarded as a Slurm
    # gres type (gpu:<type>:1); a bare `--gpu` asks for one GPU of whatever kind the partition has,
    # since the GCE default this flag carries for --gcp means nothing to Slurm. Keyed on whether a
    # type was typed rather than on whether it happens to equal that default, so `--gpu nvidia-tesla-t4`
    # is forwarded as written instead of silently collapsing into a bare request.
    #
    # A `nvidia-`-prefixed value is almost certainly a GCE name pasted from a --gcp invocation. It is
    # only warned about, not rejected -- nothing stops a site naming a gres that way -- but the warning
    # is worth the line, because sbatch's own refusal ("Invalid generic resource specification") never
    # mentions the flag the value came from.
    #
    # One GPU, not a count the caller chooses: cellbender is the only GPU consumer in the pipeline and
    # trains on a single device, so a second card would sit idle while making the job harder to
    # schedule. Set SBATCH_OPTS by hand in this script if a site ever needs otherwise.
    if [[ "$GPU" == true ]]; then
        if [[ "$GPU_TYPE_EXPLICIT" == true ]]; then
            if [[ "$GPU_TYPE" == nvidia-* ]]; then
                echo "[WARNING]: '--gpu ${GPU_TYPE}' looks like a GCE accelerator name, which Slurm does not use" >&2
                echo " • Slurm gres types come from your cluster's gres.conf, e.g. a100 or v100 -- check with \`sinfo -o '%G'\`" >&2
                echo " • Requesting --gres=gpu:${GPU_TYPE}:1 as asked; sbatch will refuse it if the cluster has no such gres" >&2
            fi
            SBATCH_OPTS+=(--gres="gpu:${GPU_TYPE}:1")
        else
            SBATCH_OPTS+=(--gres=gpu:1)
        fi
    fi

    # make uv (and conda, used by the pipeline for R/CellBender) available and sync deps here on
    # the submitting node: sbatch exports the current environment to the job by default
    # (--export=ALL), so the PATH set by these reaches the compute node (assumes a shared
    # filesystem, as is standard on Slurm clusters), and syncing now surfaces dependency errors
    # at submit time rather than inside a detached batch job
    ensure_uv
    ensure_conda
    uv sync

    # Submit as a batch job (not srun) so the run survives an SSH disconnect and executes
    # independently of this shell; --parsable makes sbatch print just the job ID.
    echo "Submitting slidr to Slurm (sbatch ${SBATCH_OPTS[*]})"
    if [[ "$SLURM_STAGE" == true ]]; then
        # Staged run: hand off to workflow/bash/slidr_slurm.sh, which runs the pipeline with this
        # checkout's config and lets it fetch its own inputs. Staging happens inside the job rather than
        # here so hundreds of GB do not move through a shared login node.
        # sbatch exports the submitting environment by default (--export=ALL), which is how these
        # reach the compute node.
        export INPUT="$INPUT_GCS"
        export BCL_ID
        export SLIDR_WORKDIR="$WORKDIR"
        export SLIDR_REPO="$SCRIPT_DIR"

        echo "  Staging inputs from: ${INPUT_GCS}"
        # name where the workdir came from: it is now usually derived rather than passed, and a
        # several-hundred-GB download landing somewhere unexpected should never be a surprise
        echo "  Staging into:        ${WORKDIR}  (from ${WORKDIR_SOURCE})"
        JOB_ID="$(sbatch --parsable "${SBATCH_OPTS[@]}" \
                  "${SCRIPT_DIR}/workflow/bash/slidr_slurm.sh" "${SLIDR_ARGS[@]}")" \
            || {
                echo "[ERROR]: sbatch submission failed" >&2
                echo "Troubleshooting:" >&2
                echo " • sbatch's own error is printed above -- it names the real cause" >&2
                echo " • Check the partition exists and you may use it: \`sinfo -s\`" >&2
                echo " • Check the requested resources fit the partition's limits (${CPUS} CPUs, ${MEM_ARG} memory, ${TIME} walltime)" >&2
                echo " • Check you are on a submit node with Slurm available: \`sinfo\`" >&2
                exit 1
            }
    else
        # Local run: invoke the pipeline directly. Built as a single shell-quoted string for
        # sbatch --wrap; --bcl is captured into $BCL_ID during arg parsing but is NOT in
        # SLIDR_ARGS, so re-add it here.
        WRAP_CMD="uv run python workflow/main.py --bcl $(printf '%q' "$BCL_ID")"
        for arg in "${SLIDR_ARGS[@]}"; do WRAP_CMD+=" $(printf '%q' "$arg")"; done

        JOB_ID="$(sbatch --parsable "${SBATCH_OPTS[@]}" --wrap="$WRAP_CMD")" \
            || {
                echo "[ERROR]: sbatch submission failed" >&2
                echo "Troubleshooting:" >&2
                echo " • sbatch's own error is printed above -- it names the real cause" >&2
                echo " • Check the partition exists and you may use it: \`sinfo -s\`" >&2
                echo " • Check the requested resources fit the partition's limits (${CPUS} CPUs, ${MEM_ARG} memory, ${TIME} walltime)" >&2
                echo " • Check you are on a submit node with Slurm available: \`sinfo\`" >&2
                exit 1
            }
    fi
    JOB_ID_NUM="${JOB_ID%%;*}"   # strip any ";cluster" suffix (federated clusters)
    LOG_FILE="${SCRIPT_DIR}/slurm-slidr-${BCL_ID}-${JOB_ID_NUM}.out"

    echo ""
    echo "Submitted batch job ${JOB_ID_NUM}"
    echo "  Log:     ${LOG_FILE}"
    echo "  Monitor: squeue -j ${JOB_ID_NUM}   |   tail -f '${LOG_FILE}'"
    echo "  Cancel:  scancel ${JOB_ID_NUM}"
    echo "The job runs independently of this shell; you can safely disconnect."
else

    # run relative-path commands (uv sync, workflow/main.py) from the repo root regardless of the
    # caller's current directory
    cd "$SCRIPT_DIR"

    ensure_uv
    ensure_conda

    # run the pipeline
    # --bcl is captured into $BCL_ID during arg parsing but is NOT in SLIDR_ARGS, so it must be
    # re-added here (the GCP path does the same in slidr_gcp.sh); main.py's --bcl is required, so
    # omitting it aborts every local run with an argparse error before any stage runs
    uv sync
    uv run python workflow/main.py --bcl "$BCL_ID" "${SLIDR_ARGS[@]}"
fi